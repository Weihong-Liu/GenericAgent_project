# GenericAgent Engineered local environment

# Optional writable state/config home. Defaults to ~/.generic-agent.
# GENERIC_AGENT_HOME=/Users/example/.generic-agent

# Default model provider and model.
GA_PROVIDER=openai
GA_MODEL=gpt-5.4
GA_LANG=zh

# Runtime switches.
GA_VERBOSE=false
GA_YOLO=false

# Optional JSON env settings, compatible with free-code-style settings.
# The same JSON shape can live in project config: .generic-agent/settings.json.
# Explicit GA_PROVIDER/GA_MODEL/etc. above still override values inside this JSON.
# GA_CONFIG_JSON={"env":{"GA_PROVIDER":"openai","GA_MODEL":"gpt-5.4"}}

# Optional proxy settings. HTTPS is preferred, then HTTP, then ALL_PROXY.
# HTTPS_PROXY=http://127.0.0.1:6152
# HTTP_PROXY=http://127.0.0.1:6152
# ALL_PROXY=socks5://127.0.0.1:6153
