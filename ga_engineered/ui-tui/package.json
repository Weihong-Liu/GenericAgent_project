{
  "name": "generic-agent-tui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript / Ink frontend for GenericAgent Engineered (M9)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx --watch src/entry.tsx",
    "start": "tsx src/entry.tsx",
    "build": "node esbuild.config.mjs",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "ink": "^6.8.0",
    "react": "^19.2.0",
    "unicode-animations": "^1.0.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
